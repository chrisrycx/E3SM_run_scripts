# Template for machine-specific settings. Copy to <name>.env and fill in.
#   cp machine.env.example pm-cpu.env
# *.env files are gitignored; only this template is committed.

# Root of the E3SM source checkout (contains cime/scripts/create_newcase)
E3SM_ROOT=/path/to/E3SM

# Root directory holding input data (domain/surface files)
DATA_ROOT=/path/to/data

# Where CIME case and run directories are created
OUTPUT_ROOT=/path/to/output

# CIME machine/compiler names and allocation project
MACH=
COMPILER=gnu
PROJECT=

# Space-separated modules to load before running (leave empty if none)
MODULES=
